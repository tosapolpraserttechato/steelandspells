static func glyph_for_skill(skill: Dictionary) -> String:
	var name := String(skill.get("name", "")).to_lower()
	for r in NAME_RULES:
		if name.contains(String(r[0])):
			return r[1]
	var fx: Dictionary = skill.get("fx", {})
	var sts: Array = fx.get("sts", [])
	var first := String(sts[0]["id"]) if sts.size() > 0 else ""
	match String(fx.get("t", "")):
		"projectile":
			match first:
				"burn": return "fireball"
				"chill", "freeze": return "ice_shard"
				"shock": return "bolt"
				"poison": return "flask"
				"root": return "vine"
			return "orb"
		"beam": return "beam"
		"cone": return "slash"
		"aoe": return "burst"
		"zone": return "cloud"
		"sprint": return "dash"
		"teleport": return "portal"
		"leap": return "fist"
		"buff": return "arrow_up"
		"heal": return "plus"
		"summon": return "skull"
		"wall": return "wall"
		"trap": return "rune"
		"strikes": return "bolt"
	return "star"




