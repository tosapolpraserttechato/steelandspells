static func glyph_for_card(card: Dictionary) -> String:
	return CARD_STAT_GLYPH.get(String(card.get("stat", "")), "star")


static func glyph_for_weapon(w: Dictionary) -> String:
	match String(w.get("family", "")):
		"sword", "enchblade": return "sword"
		"heavy": return "sword"
		"axe": return "axe"
		"mace": return "fist"
		"polearm": return "arrow_fly"
		"scythe": return "slash"
		"dagger": return "dagger"
		"claws": return "claws"
		"whip": return "vine"
		"bow", "crossbow", "spiritbow": return "bow"
		"thrown": return "axe"
		"staff": return "staff"
		"wand": return "staff"
		"orb": return "orb"
		"tome": return "book"
		"gauntlet": return "fist"
	return "sword"


static func glyph_for_slot(slot: String) -> String:
	match slot:
		"helmet": return "crown"
		"chestplate": return "shield"
		"shield": return "shield_star"
		"leggings": return "boot"
		"boots": return "boot"
	return "hex"


static func category_for_item(it: Dictionary) -> String:
	match String(it.get("kind", "")):
		"weapon": return "offense"
		"armor": return "defense"
		"rune": return "skill"
	return "utility"
