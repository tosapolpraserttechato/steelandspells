static func _def(glyph: String) -> Array:
	if GLYPHS.has(glyph):
		return GLYPHS[glyph]
	if MORE.has(glyph):
		return MORE[glyph]
	return GLYPHS["star"]


static func has_glyph(glyph: String) -> bool:
	return GLYPHS.has(glyph) or MORE.has(glyph)


## Palette chosen by what the thing is about (fire is orange, ice is blue...), mixed a little with the thing's own colour.
## `pal_key` overrides the glyph's own palette (for example a blue-white "dash" for a frost skill).
static func palette_for(glyph: String, tint: Color, pal_key: String = "") -> Dictionary:
	var key: String = pal_key if pal_key != "" else String(_def(glyph)[0])
	var base: Dictionary = PAL[key] if PAL.has(key) else (PAL2[key] if PAL2.has(key) else PAL["steel"])
	var out := {}
	for k in base:
		out[k] = (base[k] as Color).lerp(tint, 0.14 if k != "o" else 0.0)
	for k in FIXED:
		out[k] = FIXED[k]
	var m: Color = out["m"]
	out["t"] = Color(m.r, m.g, m.b, 0.3)
	return out


# ---------------------------------------------------------------- drawing

static var _prep: Dictionary = {}


static func _smooth(pts: Array) -> PackedVector2Array:
	var n := pts.size() / 2
	var p: Array[Vector2] = []
	for i in n:
		p.append(Vector2(pts[2 * i], pts[2 * i + 1]))
	var out := PackedVector2Array()
	for i in n:
		var p0 := p[(i - 1 + n) % n]
		var p1 := p[i]
		var p2 := p[(i + 1) % n]
		var p3 := p[(i + 2) % n]
		for s in 6:
			var t := float(s) / 6.0
			var t2 := t * t
			var t3 := t2 * t
			out.append(0.5 * ((2.0 * p1) + (-p0 + p2) * t + (2.0 * p0 - 5.0 * p1 + 4.0 * p2 - p3) * t2 + (-p0 + 3.0 * p1 - 3.0 * p2 + p3) * t3))
	return out


static func _points(arr: Array) -> PackedVector2Array:
	var pts := PackedVector2Array()
	for i in range(0, arr.size(), 2):
		pts.append(Vector2(arr[i], arr[i + 1]))
	return pts


static func _prepared(glyph: String) -> Array:
	if _prep.has(glyph):
		return _prep[glyph]
	var out: Array = []
	var li := 0
	for layer in _def(glyph)[1]:
		li += 1
		match String(layer[0]):
			"p":
				var pts: PackedVector2Array = _smooth(layer[2]) if layer[3] else _points(layer[2])
				if Geometry2D.triangulate_polygon(pts).is_empty():
					push_warning("IconArt: glyph %s layer %d has a bad polygon; using its hull" % [glyph, li])
					pts = Geometry2D.convex_hull(pts)
				out.append(["p", layer[1], pts])
			"c":
				out.append(["c", layer[1], Vector2(layer[2], layer[3]), float(layer[4])])
			"l":
				out.append(["l", layer[1], float(layer[2]), _points(layer[3])])
			"a":
				out.append(["a", layer[1], Vector2(layer[2], layer[3]), float(layer[4]), deg_to_rad(float(layer[5])), deg_to_rad(float(layer[6])), float(layer[7])])
			"s":
				var sp := PackedVector2Array()
				var turns: float = float(layer[3])
				var n := 36
				for i in n + 1:
					var f := float(i) / n
					var a := -PI * 0.5 + f * TAU * turns
					var rr := 0.92 * (1.0 - f) + 0.06
					sp.append(Vector2(cos(a), sin(a)) * rr)
				out.append(["l", layer[1], float(layer[2]), sp])
	_prep[glyph] = out
	return out


## Draws `glyph` into the square around `center` (radius r) on canvas item `ci`. `pal` overrides the colours (see palette_for).
static func draw_glyph(ci: CanvasItem, glyph: String, center: Vector2, r: float, tint: Color = Color(1, 1, 1), glow: bool = true, pal: Dictionary = {}, pal_key: String = "") -> void:
	if not has_glyph(glyph):
		glyph = "star"
	var colors: Dictionary = pal if not pal.is_empty() else palette_for(glyph, tint, pal_key)
	ci.draw_set_transform(center, 0.0, Vector2(r, r))
	if glow:
		var g: Color = colors["m"]
		for i in 5:
			ci.draw_circle(Vector2.ZERO, 1.25 - 0.1 * i, Color(g.r, g.g, g.b, 0.06 + 0.02 * i))
	for layer in _prepared(glyph):
		var col: Color = colors.get(layer[1], Color.MAGENTA)
		match String(layer[0]):
			"p":
				ci.draw_colored_polygon(layer[2], col)
			"c":
				ci.draw_circle(layer[2], layer[3], col)
			"l":
				ci.draw_polyline(layer[3], col, layer[2], true)
			"a":
				ci.draw_arc(layer[2], layer[3], layer[4], layer[5], 28, col, layer[6], true)
	ci.draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)


# ---------------------------------------------------------------- items

static func glyph_for_item(it: Dictionary) -> String:
	match String(it.get("kind", "")):
		"weapon":
			if Data.weapons.has(it.get("id", "")):
				return glyph_for_weapon(Data.weapons[it["id"]])
			return "sword"
		"armor":
			return glyph_for_slot(String(it.get("slot", "")))
		"rune":
			return "rune"
	return "star"


## Background colours for the art panel of an item or card: [dark, light].
static func category_colors(cat: String) -> Array:
	return CATEGORY_COLORS.get(cat, CATEGORY_COLORS["utility"])


## The picture in a card's art window: gradient, turning rays, glow, the glyph with a shadow, sparkles for the rarer ones.
static func draw_card_art(ci: CanvasItem, rect: Rect2, glyph: String, cat: String, rarity_col: Color, t: float, rarity_i: int, seed_i: int = 0, pal_key: String = "", tex: Texture2D = null) -> void:
	var cc: Array = category_colors(cat)
	var dark: Color = cc[0]
	var light: Color = cc[1]
	var top := dark.darkened(0.35)
	var bot := dark.lerp(light, 0.45)
	var pts := PackedVector2Array([rect.position, rect.position + Vector2(rect.size.x, 0), rect.position + rect.size, rect.position + Vector2(0, rect.size.y)])
	ci.draw_polygon(pts, PackedColorArray([top, top, bot, bot]))
	var c := rect.get_center() + Vector2(0, rect.size.y * 0.02)
	var rad := minf(rect.size.x, rect.size.y)
	# rays, clipped to the window by only reaching its edge (the window is wider than tall, so rays are cut to the rect)
	var rays := 12
	var spin := t * (0.12 + 0.04 * rarity_i)
	for i in rays:
		var a0 := spin + TAU * i / rays
		var a1 := a0 + TAU / rays * 0.5
		var far := rad * 1.2
		var p0 := _clip_to_rect(c, c + Vector2(cos(a0), sin(a0)) * far, rect)
		var p1 := _clip_to_rect(c, c + Vector2(cos(a1), sin(a1)) * far, rect)
		ci.draw_colored_polygon(PackedVector2Array([c, p0, p1]), Color(light.r, light.g, light.b, 0.12 + 0.02 * rarity_i))
	for i in 4:
		ci.draw_circle(c, rad * (0.46 - 0.07 * i), Color(light.r, light.g, light.b, 0.07 + 0.03 * i))
	# floor shadow
	ci.draw_set_transform(c + Vector2(0, rad * 0.4), 0.0, Vector2(1.0, 0.28))
	ci.draw_circle(Vector2.ZERO, rad * 0.3, Color(0, 0, 0, 0.35))
	ci.draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
	var bob := sin(t * 1.6 + seed_i) * rad * 0.012 * (1 + rarity_i)
	if tex != null:
		var s2 := rad * 0.92
		ci.draw_texture_rect(tex, Rect2(c + Vector2(0, bob) - Vector2(s2, s2) * 0.5, Vector2(s2, s2)), false)
	else:
		draw_glyph(ci, glyph, c + Vector2(0, bob), rad * 0.34, rarity_col, true, {}, pal_key)
	# sparkles
	var sp := 3 + rarity_i * 2
	for i in sp:
		var h := float(posmod((seed_i + i) * 2654435761, 1000)) / 1000.0
		var h2 := float(posmod((seed_i + i) * 40503 + 7, 997)) / 997.0
		var pos := rect.position + Vector2(h, h2) * rect.size
		var tw := 0.5 + 0.5 * sin(t * 2.2 + i * 1.7)
		var s := rad * 0.018 * (0.6 + tw)
		ci.draw_line(pos + Vector2(-s * 2, 0), pos + Vector2(s * 2, 0), Color(1, 1, 1, 0.25 + 0.5 * tw), 1.5)
		ci.draw_line(pos + Vector2(0, -s * 2), pos + Vector2(0, s * 2), Color(1, 1, 1, 0.25 + 0.5 * tw), 1.5)
	# inner frame
	ci.draw_rect(rect, Color(0, 0, 0, 0.55), false, 2.0)
	ci.draw_rect(rect.grow(-2.0), Color(rarity_col.r, rarity_col.g, rarity_col.b, 0.6), false, 1.5)


## Where the segment from `a` (inside) to `b` leaves `rect`.
static func _clip_to_rect(a: Vector2, b: Vector2, rect: Rect2) -> Vector2:
	var d := b - a
	var tmax := 1.0
	if d.x > 0.0:
		tmax = minf(tmax, (rect.end.x - a.x) / d.x)
	elif d.x < 0.0:
		tmax = minf(tmax, (rect.position.x - a.x) / d.x)
	if d.y > 0.0:
		tmax = minf(tmax, (rect.end.y - a.y) / d.y)
	elif d.y < 0.0:
		tmax = minf(tmax, (rect.position.y - a.y) / d.y)
	return a + d * maxf(tmax, 0.0)

